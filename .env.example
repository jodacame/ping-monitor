# ---------------------------------------------------------------------------
# Ping Monitor — environment configuration (EXAMPLE)
#
# Copy this file to `.env` and adjust the values. It is read both by
# `docker compose` (for the bundled stack) and by the Node services when run
# directly. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Log verbosity: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ===========================================================================
# Docker Compose — the default self-hosting path:
#   cp .env.example .env  &&  docker compose up -d --build
# These are the only values you normally need to change.
# ===========================================================================

# Bundled PostgreSQL credentials. Compose builds DATABASE_URL from these and the
# database runs inside the stack. Use a strong password for any real deployment.
POSTGRES_USER=ping
POSTGRES_PASSWORD=change_me_please
POSTGRES_DB=ping

# Auth signing key — 32+ random bytes. Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Host port the dashboard is published on  ->  http://localhost:8080
WEB_PORT=8080

# This node's probe region code. Must exist in `probe_regions` ('local' is
# seeded by default). Set a distinct code per region for multi-region workers.
PROBE_REGION=local

# Open self-service registration. Off by default: only the FIRST account is
# allowed (clean-install onboarding); afterwards sign-up is closed. Set 'true'
# to let anyone register.
ALLOW_REGISTRATION=false

# How many proxies sit between the client and the API. The client IP decides
# rate limiting and API-key IP allowlists, so this MUST match your topology:
#   1  this Compose bundle as shipped (nginx is the only proxy)  <- default
#   2  something else fronts nginx (Cloudflare Tunnel, Traefik, a load balancer)
# Setting it higher than the real number of proxies lets any caller forge their
# own IP and bypass both protections. Use 'false' if the API is exposed
# directly, with no proxy at all.
TRUST_PROXY=1

# ===========================================================================
# Running the Node services WITHOUT Docker (local development)
#
# Compose sets DATABASE_URL / REDIS_URL itself (pointing at its own postgres and
# redis services) and ignores the two below — they only apply when you run the
# services directly with pnpm.
# ===========================================================================

DATABASE_URL=postgresql://ping:ping@localhost:5432/ping
REDIS_URL=redis://localhost:6379

# API server
API_HOST=0.0.0.0
API_PORT=3000
JWT_ACCESS_TTL=900          # seconds (15 min)
JWT_REFRESH_TTL=2592000     # seconds (30 days)
# Comma-separated list of allowed browser origins for CORS (dev SPA).
CORS_ORIGIN=http://localhost:5173
# Base URL the SPA (Vite dev server) uses to reach the API.
VITE_API_URL=http://localhost:3000

# Connection pool sizing (per process). Lower these on small hosts (e.g. a Pi).
PGPOOL_MAX=10
PGPOOL_IDLE_TIMEOUT_MS=30000

# --- Scheduler ---------------------------------------------------------------
SCHEDULER_TICK_MS=1000       # how often to scan for due monitors (ms)
SCHEDULER_BATCH_SIZE=2000    # max monitors claimed and enqueued per tick

# --- Worker ------------------------------------------------------------------
WORKER_CONCURRENCY=100       # concurrent checks per worker process
CHECK_QUEUE_STREAM=checks:pending
CHECK_QUEUE_GROUP=workers
RESULT_FLUSH_INTERVAL_MS=1000
RESULT_FLUSH_MAX_ROWS=500

# --- Data retention (compaction) --------------------------------------------
RAW_RETENTION_DAYS=14        # raw per-check rows pruned after N days
HOURLY_RETENTION_DAYS=90
DAILY_RETENTION_DAYS=0       # 0 = keep daily rollups forever
