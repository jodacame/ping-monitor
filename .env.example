# ---------------------------------------------------------------------------
# Ping Monitor — environment configuration (EXAMPLE)
#
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# On the shared dev server the DATABASE_URL/REDIS_URL point at the shared
# services (dev-postgres / dev-redis) on the `devnet` Docker network.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
LOG_LEVEL=info

# --- PostgreSQL --------------------------------------------------------------
# Provisioned with: dev db provision ping_monitor
DATABASE_URL=postgresql://ping_monitor:CHANGE_ME@dev-postgres:5432/ping_monitor
# Connection pool sizing (per process). Tune for your workload.
PGPOOL_MAX=10
PGPOOL_IDLE_TIMEOUT_MS=30000

# --- Redis (queue + coordination) -------------------------------------------
REDIS_URL=redis://dev-redis:6379

# --- API ---------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3000
# 32+ random bytes. Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ACCESS_TTL=900          # seconds (15 min)
JWT_REFRESH_TTL=2592000     # seconds (30 days)
# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGIN=http://localhost:5173

# --- Scheduler ---------------------------------------------------------------
# How often the scheduler scans for due monitors (ms).
SCHEDULER_TICK_MS=1000
# Max monitors claimed and enqueued per tick.
SCHEDULER_BATCH_SIZE=2000

# --- Worker ------------------------------------------------------------------
# Concurrent checks per worker process.
WORKER_CONCURRENCY=100
# Redis stream / consumer-group names for the check queue.
CHECK_QUEUE_STREAM=checks:pending
CHECK_QUEUE_GROUP=workers
# Flush buffered results to Postgres every N ms or every N rows, whichever first.
RESULT_FLUSH_INTERVAL_MS=1000
RESULT_FLUSH_MAX_ROWS=500

# --- Data retention (compaction) --------------------------------------------
# Raw per-check rows are pruned after this many days (rollups are kept longer).
RAW_RETENTION_DAYS=14
HOURLY_RETENTION_DAYS=90
# Daily rollups are tiny and kept indefinitely by default (0 = keep forever).
DAILY_RETENTION_DAYS=0

# --- Web (build-time) --------------------------------------------------------
# Base URL the SPA uses to reach the API.
VITE_API_URL=http://localhost:3000
