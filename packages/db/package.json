{
  "name": "@ping/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PostgreSQL access layer: connection pool, SQL migrations, compact codecs and repositories.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/migrate-cli.ts up",
    "migrate:status": "tsx src/migrate-cli.ts status"
  },
  "dependencies": {
    "@ping/config": "workspace:*",
    "@ping/core": "workspace:*",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0"
  }
}
