{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,

    "sourceMap": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    "baseUrl": ".",
    "paths": {
      "@ping/core": ["packages/core/src/index.ts"],
      "@ping/config": ["packages/config/src/index.ts"],
      "@ping/db": ["packages/db/src/index.ts"],
      "@ping/queue": ["packages/queue/src/index.ts"],
      "@ping/checks": ["packages/checks/src/index.ts"],
      "@ping/notifications": ["packages/notifications/src/index.ts"]
    }
  }
}
