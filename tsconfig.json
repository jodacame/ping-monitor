{
  "//": "Backend typecheck program. The web app has its own DOM-oriented tsconfig.",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/test/**/*.ts", "apps/*/src/**/*.ts"],
  "exclude": ["apps/web", "**/dist", "**/node_modules"]
}
